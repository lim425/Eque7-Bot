<?xml version="1.0"?>
<robot name="eque7_robot" xmlns:xacro="http://ros.org/wiki/xacro">


    <xacro:arg name="is_sim" default="false" />
    <xacro:property name="package_name" value="eque7_description" />
    <xacro:include filename="$(find ${package_name})/urdf/eque7_gazebo.xacro" />
    <xacro:include filename="$(find ${package_name})/urdf/eque7_ros2_control.xacro" />
    <xacro:include filename="$(find realsense2_description)/urdf/_d415.urdf.xacro" />

    <!-- Wheel Properties -->
    <xacro:property name="wheel_radius" value="0.033" />
    <xacro:property name="wheel_separation" value="0.181" />
    <!-- old wheel seperation 0.17 (works in simulation)-->
    <!-- <xacro:property name="wheel_separation" value="0.17" />   -->
    <!-- <xacro:property name="wheel_separation" value="0.176066" /> -->
    <xacro:property name="wheel_mass" value="0.053" />

    <!-- Caster Properties -->
    <xacro:property name="caster_radius" value="0.015" />
    <xacro:property name="caster_x_offset" value="-0.082095" />
    <xacro:property name="caster_z_offset" value="${-(wheel_radius - caster_radius)}" />

    <!-- Base Properties -->
    <xacro:property name="base_height" value="${wheel_radius}" />
    <xacro:property name="base_mass" value="0.825" />

    <!-- Wheel Joint Offsets (from SolidWorks) -->
    <!-- <xacro:property name="wheel_left_x_offset" value="0.00042182" />
    <xacro:property name="wheel_left_z_offset" value="0.00010798" />
    <xacro:property name="wheel_right_x_offset" value="0.0" />
    <xacro:property name="wheel_right_z_offset" value="0.00042063" /> -->
    <xacro:property name="wheel_left_x_offset" value="0.0" />
    <xacro:property name="wheel_left_z_offset" value="0.0" />
    <xacro:property name="wheel_right_x_offset" value="0.0" />
    <xacro:property name="wheel_right_z_offset" value="0.0" />

    <!-- IMU Properties -->
    <xacro:property name="imu_x" value="-0.023898" />
    <xacro:property name="imu_y" value="8.9275E-05" />
    <xacro:property name="imu_z" value="0.1035" />

    <!-- Lidar Properties -->
    <xacro:property name="lidar_x" value="-0.026207" />
    <xacro:property name="lidar_y" value="-2.5391E-05" />
    <xacro:property name="lidar_z" value="0.1955" />

    <!-- Camera Properties (for future use) -->
    <xacro:property name="camera_x" value="0.0199" />
    <xacro:property name="camera_y" value="0.0" />
    <xacro:property name="camera_z" value="0.1158" />


    <!-- ======================= -->
    <!-- BASE FOOTPRINT LINK     -->
    <!-- ======================= -->
    <link name="base_footprint" />

    <!-- ======================= -->
    <!-- BASE LINK               -->
    <!-- ======================= -->
    <link name="base_link">
        <inertial>
            <origin xyz="0 0 0.04" rpy="0.0 0.25 0.3" />
            <mass value="${base_mass}" />
            <inertia ixx="2.2124416e-02" ixy="-1.2294101e-04" ixz="3.4938785e-04"
                iyy="2.1193702e-02" iyz="-5.0120904e-05"
                izz="2.0064271e-02" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://${package_name}/meshes/base_link.STL" />
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://${package_name}/meshes/base_link.STL" />
            </geometry>
        </collision>
    </link>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 ${base_height}" rpy="0 0 0" />
    </joint>

    <!-- ======================= -->
    <!-- LEFT WHEEL LINK         -->
    <!-- ======================= -->
    <link name="wheel_left_link">
        <inertial>
            <origin xyz="0 0.014 0" rpy="0 0 0" />
            <mass value="${wheel_mass}" />
            <inertia ixx="1.8792911368909E-05" ixy="3.31256392204584E-10"
                ixz="-1.14082001662767E-08"
                iyy="3.11510738759073E-05" iyz="-3.60499245082192E-10"
                izz="1.88266886146847E-05" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://${package_name}/meshes/wheel_left_link.STL" />
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <sphere radius="${wheel_radius}" />
            </geometry>
        </collision>
    </link>

    <joint name="wheel_left_joint" type="continuous">
        <origin xyz="${wheel_left_x_offset} ${wheel_separation/2} ${wheel_left_z_offset}" rpy="0 0 0" />
        <parent link="base_link" />
        <child link="wheel_left_link" />
        <axis xyz="0 1 0" />
    </joint>

    <!-- ======================= -->
    <!-- RIGHT WHEEL LINK        -->
    <!-- ======================= -->
    <link name="wheel_right_link">
        <inertial>
            <origin xyz="0 -0.014 0" rpy="0 0 0" />
            <mass value="${wheel_mass}" />
            <inertia ixx="1.88176298336665E-05" ixy="-4.8444933029987E-10"
                ixz="1.88163708851143E-08"
                iyy="3.11510738647764E-05" iyz="-6.93560663069607E-11"
                izz="1.8801969558182E-05" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://${package_name}/meshes/wheel_right_link.STL" />
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <sphere radius="${wheel_radius}" />
            </geometry>
        </collision>
    </link>

    <joint name="wheel_right_joint" type="continuous">
        <origin xyz="${wheel_right_x_offset} ${-wheel_separation/2} ${wheel_right_z_offset}" rpy="0 0 0" />
        <parent link="base_link" />
        <child link="wheel_right_link" />
        <axis xyz="0 1 0" />
    </joint>

    <!-- ======================= -->
    <!-- CASTER WHEEL LINK       -->
    <!-- ======================= -->
    <link name="caster_wheel_link">
        <inertial>
            <origin xyz="3.89968128948481E-07 2.40073004698083E-07 0.00219173397061506" rpy="0 0 0" />
            <mass value="1.44379265037903E-06" />
            <inertia ixx="7.23075276010246E-11" ixy="-6.10956883467859E-16"
                ixz="2.22849693525031E-15"
                iyy="3.8713793085917E-11" iyz="2.93909858781952E-15"
                izz="1.00967486676306E-10" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://${package_name}/meshes/caster_wheel_link.STL" />
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <sphere radius="${caster_radius}" />
            </geometry>
        </collision>
    </link>

    <joint name="caster_wheel_joint" type="fixed">
        <origin xyz="${caster_x_offset} 0 ${caster_z_offset}" rpy="0 0 0" />
        <parent link="base_link" />
        <child link="caster_wheel_link" />
    </joint>

    <!-- ======================= -->
    <!-- IMU SENSOR              -->
    <!-- ======================= -->
    <link name="imu_link">
        <inertial>
            <origin xyz="-0.00552433659106688 0.000168210391520346 0.000514000497342681" rpy="0 0 0" />
            <mass value="0.000528415362211671" />
            <inertia ixx="1.46176048428261E-08" ixy="1.40015117949421E-10"
                ixz="-1.99633872937403E-12"
                iyy="8.59662482954888E-09" iyz="7.52375112767959E-12"
                izz="2.30279421279312E-08" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://${package_name}/meshes/imu_link.STL" />
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://${package_name}/meshes/imu_link.STL" />
            </geometry>
        </collision>
    </link>

    <joint name="imu_joint" type="fixed">
        <parent link="base_link" />
        <child link="imu_link" />
        <origin xyz="${imu_x} ${imu_y} ${imu_z}" rpy="0 0 0" />
    </joint>

    <!-- ======================= -->
    <!-- LIDAR                   -->
    <!-- ======================= -->
    <link name="laser_link">
        <inertial>
            <origin xyz="-0.011945780406062 -0.000381929217680526 -0.0170649378129477" rpy="0 0 0" />
            <mass value="0.073084435549317" />
            <inertia ixx="1.96074931730795E-05" ixy="-3.62091076640009E-07"
                ixz="4.28230084046735E-07"
                iyy="2.40983835136327E-05" iyz="1.50180909250652E-08"
                izz="4.14184164228595E-05" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://${package_name}/meshes/laser_link.STL" />
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://${package_name}/meshes/laser_link.STL" />
            </geometry>
        </collision>
    </link>

    <joint name="laser_joint" type="fixed">
        <origin xyz="${lidar_x} ${lidar_y} ${lidar_z}" rpy="0 0 0" />
        <parent link="base_link" />
        <child link="laser_link" />
    </joint>

    <!-- ======================= -->
    <!-- Camera RealSense D415   -->
    <!-- ======================= -->
    <xacro:sensor_d415 parent="base_link" name="camera" use_nominal_extrinsics="false">
        <origin xyz="${camera_x} ${camera_y} ${camera_z}" rpy="0 0 0" />
    </xacro:sensor_d415>
    
</robot>